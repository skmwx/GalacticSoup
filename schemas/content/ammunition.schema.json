{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-soup.local/schemas/content/ammunition.schema.json",
  "title": "Ammunition definitions",
  "description": "Charges a turret can load. Functional Specification 9.4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "definitions"
  ],
  "properties": {
    "kind": {
      "const": "ammunition"
    },
    "$comment": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "damagePerShot",
          "descriptionKey",
          "falloffMultiplier",
          "group",
          "id",
          "nameKey",
          "optimalRangeMultiplier",
          "referenceValueCredits",
          "trackingMultiplier",
          "volumeCubicMetres"
        ],
        "properties": {
          "id": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/ammunitionId"
          },
          "nameKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "descriptionKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "group": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/ammunitionGroup"
          },
          "damagePerShot": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/damageProfile"
          },
          "optimalRangeMultiplier": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveNumber"
          },
          "falloffMultiplier": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveNumber"
          },
          "trackingMultiplier": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveNumber"
          },
          "volumeCubicMetres": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/cubicMetres"
          },
          "referenceValueCredits": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/credits"
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
