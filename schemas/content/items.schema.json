{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-soup.local/schemas/content/items.schema.json",
  "title": "Item definitions",
  "description": "Goods that are neither module nor ammunition. Functional Specification 6.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "definitions"
  ],
  "properties": {
    "kind": {
      "const": "items"
    },
    "$comment": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "descriptionKey",
          "id",
          "nameKey",
          "referenceValueCredits",
          "volumeCubicMetres"
        ],
        "properties": {
          "id": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/definitionId",
            "pattern": "^item\\.",
            "type": "string"
          },
          "nameKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "descriptionKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "category": {
            "enum": [
              "salvage",
              "commodity"
            ]
          },
          "volumeCubicMetres": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/cubicMetres"
          },
          "referenceValueCredits": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/credits"
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
