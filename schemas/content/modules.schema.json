                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/cubicMetres"
              },
              "referenceValueCredits": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/credits"
              },
              "category": {
                "const": "capacitorBattery"
              },
              "capacitorSupport": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capacityBonus",
                  "rechargeBonusFraction"
                ],
                "properties": {
                  "capacityBonus": {
                    "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/nonNegativeNumber"
                  },
                  "rechargeBonusFraction": {
                    "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/nonNegativeNumber"
                  }
                }
              },
              "$comment": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "descriptionKey",
              "fitting",
              "id",
              "modifiers",
              "nameKey",
              "referenceValueCredits",
              "slot",
              "volumeCubicMetres"
            ],
            "properties": {
              "id": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/moduleId"
              },
              "nameKey": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
              },
              "descriptionKey": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
              },
              "slot": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/slotKind"
              },
              "hardpoint": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/hardpointKind"
              },
              "size": {
                "enum": [
                  "small",
                  "medium"
                ],
                "description": "The module size (Functional Specification 8.4). A sized module states it; a non-sized support module states suitsSizes instead."
              },
              "suitsSizes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "small",
                    "medium"
                  ]
                },
                "description": "Hull module sizes a non-sized support module suits."
              },
              "fitting": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "powerUse",
                  "processingUse"
                ],
                "properties": {
                  "powerUse": {
                    "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/nonNegativeNumber"
                  },
                  "processingUse": {
                    "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/nonNegativeNumber"
                  }
                }
              },
              "activation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capacitorPerCycle",
                  "cycleSeconds"
                ],
                "properties": {
                  "capacitorPerCycle": {
                    "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/nonNegativeNumber"
                  },
                  "cycleSeconds": {
                    "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveNumber"
                  }
                }
              },
              "volumeCubicMetres": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/cubicMetres"
              },
              "referenceValueCredits": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/credits"
              },
              "category": {
                "enum": [
                  "shieldExtender",
                  "shieldRecharger",
                  "capacitorRecharger",
                  "weaponUpgrade"
                ]
              },
              "modifiers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "operator",
                    "value"
                  ],
                  "properties": {
                    "operator": {
                      "enum": [
                        "shieldCapacity",
                        "shieldRechargeTime",
                        "capacitorRechargeTime",
                        "signatureRadius",
                        "projectileDamage",
                        "hybridDamage",
                        "turretTracking",
                        "guidedExplosionRadius",
                        "guidedExplosionVelocity"
                      ]
                    },
                    "value": {
                      "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveNumber"
                    }
                  }
                },
                "description": "Registered passive operators. Semantic validation refuses an operator the category may not use (Technical Specification 6.2, 10.2)."
              },
              "$comment": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
