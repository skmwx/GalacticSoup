{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-soup.local/schemas/content/reference.fits.schema.json",
  "title": "Reference fits",
  "description": "Complete, legally obtainable fits used as balance and verification fixtures (FeatureSpec02 5.3). Authoring-only: validated with the content but not compiled into the runtime bundle, and never granted to the player.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "fits"
  ],
  "properties": {
    "kind": {
      "const": "reference.fits"
    },
    "$comment": {
      "type": "string"
    },
    "fits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approach",
          "hullId",
          "id",
          "modules",
          "reserve"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fit(\\.[a-z0-9][a-z0-9-]*)+$",
            "maxLength": 96
          },
          "hullId": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/hullId"
          },
          "approach": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The decision the fit embodies, for balance reports."
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "moduleId"
              ],
              "properties": {
                "moduleId": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/moduleId"
                },
                "ammunitionId": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/ammunitionId"
                },
                "online": {
                  "type": "boolean"
                }
              }
            }
          },
          "reserve": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ammunitionId",
                "quantity"
              ],
              "properties": {
                "ammunitionId": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/ammunitionId"
                },
                "quantity": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveCount"
                }
              }
            }
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
