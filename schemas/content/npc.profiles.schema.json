{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-soup.local/schemas/content/npc.profiles.schema.json",
  "title": "NPC profiles",
  "description": "Hull, loadout, role, bounty and loot of an NPC ship. Functional Specification 9.10-9.11.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "definitions"
  ],
  "properties": {
    "kind": {
      "const": "npc.profiles"
    },
    "$comment": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bountyCredits",
          "hullId",
          "id",
          "loadout",
          "lootTableId",
          "nameKey",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/npcProfileId"
          },
          "nameKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "role": {
            "enum": [
              "brawler",
              "skirmisher",
              "sniper"
            ]
          },
          "hullId": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/hullId"
          },
          "loadout": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modules"
            ],
            "properties": {
              "modules": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/moduleId"
                }
              },
              "ammunitionId": {
                "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/ammunitionId"
              },
              "reserveRounds": {
                "description": "Rounds of the loadout's ammunition carried in the hold for reloads.",
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "bountyCredits": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/credits"
          },
          "lootTableId": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/lootTableId"
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
