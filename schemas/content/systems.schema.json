{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-soup.local/schemas/content/systems.schema.json",
  "title": "System definitions",
  "description": "Stellar systems and their sites. Functional Specification 5.1-5.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "definitions"
  ],
  "properties": {
    "kind": {
      "const": "systems"
    },
    "$comment": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dangerRating",
          "id",
          "nameKey",
          "sites"
        ],
        "properties": {
          "id": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/systemId"
          },
          "nameKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "dangerRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "sites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "nameKey",
                "position"
              ],
              "properties": {
                "id": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/siteId"
                },
                "nameKey": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
                },
                "kind": {
                  "enum": [
                    "station",
                    "combat"
                  ]
                },
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "xKm",
                    "yKm"
                  ],
                  "properties": {
                    "xKm": {
                      "type": "number"
                    },
                    "yKm": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
