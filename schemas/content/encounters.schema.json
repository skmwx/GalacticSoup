{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galactic-soup.local/schemas/content/encounters.schema.json",
  "title": "Encounter definitions",
  "description": "Authored combat sites. MVP Scope 4.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "definitions"
  ],
  "properties": {
    "kind": {
      "const": "encounters"
    },
    "$comment": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "descriptionKey",
          "id",
          "nameKey",
          "repeatable",
          "rewardSummaryKey",
          "siteId",
          "spawns",
          "systemId",
          "tier"
        ],
        "properties": {
          "id": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/encounterId"
          },
          "nameKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "descriptionKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "rewardSummaryKey": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/messageKey"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "systemId": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/systemId"
          },
          "siteId": {
            "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/siteId"
          },
          "repeatable": {
            "type": "boolean"
          },
          "spawns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count",
                "npcProfileId",
                "spawnDistanceKm"
              ],
              "properties": {
                "npcProfileId": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/npcProfileId"
                },
                "count": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveCount"
                },
                "spawnDistanceKm": {
                  "$ref": "https://galactic-soup.local/schemas/content/common.schema.json#/$defs/positiveNumber"
                }
              }
            }
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
