{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/save/campaign-state.schema.json",
  "title": "CampaignState",
  "description": "Authoritative campaign state version 2: wallet, ships and physical inventories (Technical Specification 8, 11).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateVersion",
    "campaignId",
    "displayName",
    "seed",
    "createdAtRealMs",
    "revision",
    "nextEntityOrdinal",
    "nextEventOrdinal",
    "time",
    "random",
    "scheduler",
    "assets"
  ],
  "properties": {
    "stateVersion": {
      "const": 2
    },
    "campaignId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "createdAtRealMs": {
      "description": "Display only. Excluded from the authoritative state hash.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nextEntityOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nextEventOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulationTimeMs",
        "paused",
        "rate",
        "accumulatorMs"
      ],
      "properties": {
        "simulationTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "paused": {
          "type": "boolean"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "accumulatorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combat",
        "economy",
        "encounter",
        "loot",
        "world"
      ],
      "properties": {
        "combat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "s0",
            "s1",
            "s2",
            "s3",
            "drawIndex"
          ],
          "properties": {
            "s0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "drawIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "economy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "s0",
            "s1",
            "s2",
            "s3",
            "drawIndex"
          ],
          "properties": {
            "s0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "drawIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "encounter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "s0",
            "s1",
            "s2",
            "s3",
            "drawIndex"
          ],
          "properties": {
            "s0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "drawIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "loot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "s0",
            "s1",
            "s2",
            "s3",
            "drawIndex"
          ],
          "properties": {
            "s0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "drawIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "s0",
            "s1",
            "s2",
            "s3",
            "drawIndex"
          ],
          "properties": {
            "s0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "s3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "drawIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "nextInsertionOrdinal"
      ],
      "properties": {
        "nextInsertionOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entryId",
              "kind",
              "dueAtMs",
              "priority",
              "insertionOrdinal",
              "ownerId"
            ],
            "properties": {
              "entryId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "dueAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "priority": {
                "type": "integer"
              },
              "insertionOrdinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "ownerId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credits",
        "location",
        "activeShipId",
        "ships",
        "inventories",
        "stacks"
      ],
      "properties": {
        "credits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stationId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "station"
            },
            "stationId": {
              "type": "string",
              "pattern": "^station(?:\\.[a-z0-9][a-z0-9-]*)+$",
              "maxLength": 96
            },
            "systemId": {
              "type": "string",
              "pattern": "^system(?:\\.[a-z0-9][a-z0-9-]*)+$",
              "maxLength": 96
            }
          }
        },
        "activeShipId": {
          "type": "string",
          "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
        },
        "ships": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "hullId",
              "cargoInventoryId",
              "location"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
              },
              "hullId": {
                "type": "string",
                "pattern": "^hull(?:\\.[a-z0-9][a-z0-9-]*)+$",
                "maxLength": 96
              },
              "cargoInventoryId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "stationId",
                  "systemId"
                ],
                "properties": {
                  "kind": {
                    "const": "station"
                  },
                  "stationId": {
                    "type": "string",
                    "pattern": "^station(?:\\.[a-z0-9][a-z0-9-]*)+$",
                    "maxLength": 96
                  },
                  "systemId": {
                    "type": "string",
                    "pattern": "^system(?:\\.[a-z0-9][a-z0-9-]*)+$",
                    "maxLength": 96
                  }
                }
              }
            }
          }
        },
        "inventories": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "location",
              "capacity"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
              },
              "location": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "stationId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "hangar"
                      },
                      "stationId": {
                        "type": "string",
                        "pattern": "^station(?:\\.[a-z0-9][a-z0-9-]*)+$",
                        "maxLength": 96
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "shipId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "cargo"
                      },
                      "shipId": {
                        "type": "string",
                        "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sourceInventoryId",
                      "ownerId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "reserve"
                      },
                      "sourceInventoryId": {
                        "type": "string",
                        "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
                      },
                      "ownerId": {
                        "type": "string",
                        "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
                      }
                    }
                  }
                ]
              },
              "capacity": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "unlimited"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "volumeCubicDecimetres"
                    ],
                    "properties": {
                      "kind": {
                        "const": "limited"
                      },
                      "volumeCubicDecimetres": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "inventoryId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "shared"
                      },
                      "inventoryId": {
                        "type": "string",
                        "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "stacks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "definitionId",
              "quantity",
              "inventoryId",
              "state",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
              },
              "definitionId": {
                "type": "string",
                "pattern": "^(item|module|ammo)(?:\\.[a-z0-9][a-z0-9-]*)+$",
                "maxLength": 96
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "inventoryId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
              },
              "state": {
                "const": "plain"
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "grantedQuantity",
                  "purchasedQuantity",
                  "purchaseCostCredits"
                ],
                "properties": {
                  "grantedQuantity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "purchasedQuantity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "purchaseCostCredits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
