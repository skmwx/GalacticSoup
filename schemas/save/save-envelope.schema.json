{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/save/save-envelope.schema.json",
  "title": "SaveEnvelope",
  "description": "A stored Galactic Soup save, format version 6 (Technical Specification 11.2). The envelope is self-describing and self-verifying: it names the build and content it was written against, and carries a SHA-256 over the canonical form of every field except the checksum itself. The checksum detects accidental corruption and incomplete copies; it is not protection against deliberate save editing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "protocolVersion",
    "engineVersion",
    "contentVersion",
    "contentHash",
    "slotId",
    "saveId",
    "campaignId",
    "displayName",
    "kind",
    "sequence",
    "revision",
    "simulationTimeMs",
    "savedAtRealMs",
    "state",
    "checksum"
  ],
  "properties": {
    "format": {
      "const": "galactic-soup/save"
    },
    "formatVersion": {
      "const": 6
    },
    "protocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slotId": {
      "type": "string",
      "minLength": 1
    },
    "saveId": {
      "type": "string",
      "minLength": 1
    },
    "campaignId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "kind": {
      "enum": [
        "auto",
        "manual"
      ]
    },
    "sequence": {
      "description": "Per-slot monotonic capture counter; orders rotation.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "simulationTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "savedAtRealMs": {
      "description": "Display only. No rule may read it.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "$ref": "https://galacticsoup.invalid/schemas/save/campaign-state.schema.json"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
