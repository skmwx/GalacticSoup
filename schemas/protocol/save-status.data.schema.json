{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/save-status.data.schema.json",
  "title": "SaveStatusData",
  "description": "What the save subsystem is doing (Technical Specification 11.3). Saving never blocks simulation, so progress is reported from this projection rather than from a command response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "backend",
    "slotId",
    "lastSavedRevision",
    "lastSavedAtRealMs",
    "lastSaveKind",
    "pendingWrites",
    "storage",
    "error"
  ],
  "properties": {
    "state": {
      "enum": [
        "idle",
        "pending",
        "saved",
        "failed"
      ]
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "slotId": {
      "type": "string",
      "minLength": 1
    },
    "lastSavedRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSavedAtRealMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSaveKind": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "manual"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingWrites": {
      "type": "integer",
      "minimum": 0
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistent",
        "usageBytes",
        "quotaBytes",
        "lowSpace"
      ],
      "properties": {
        "persistent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "usageBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "quotaBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lowSpace": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://galacticsoup.invalid/schemas/protocol/engine-error.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
