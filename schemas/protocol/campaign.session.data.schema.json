{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/campaign.session.data.schema.json",
  "title": "SessionData",
  "description": "Persistent-frame view model (Functional Specification 19.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign",
    "time",
    "engineVersion",
    "contentVersion",
    "contentHash"
  ],
  "properties": {
    "campaign": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaignId",
            "displayName",
            "createdAtRealMs",
            "stateVersion"
          ],
          "properties": {
            "campaignId": {
              "type": "string",
              "pattern": "^c[0-9a-f]{24}$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "createdAtRealMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stateVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paused",
        "rate",
        "availableRates",
        "quantumMs"
      ],
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "availableRates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "quantumMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
