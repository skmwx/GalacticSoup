{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/inventory.maximum.data.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "stackId",
    "destinationInventoryId",
    "maximumQuantity",
    "unavailableReason"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stackId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
    },
    "destinationInventoryId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
    },
    "maximumQuantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unavailableReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
