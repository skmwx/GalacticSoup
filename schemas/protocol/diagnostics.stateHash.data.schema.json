{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/diagnostics.stateHash.data.schema.json",
  "title": "StateHashData",
  "description": "Canonical authoritative-state hash (Technical Specification 9.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaignId",
    "revision",
    "simulationTimeMs",
    "stateHash",
    "contentHash"
  ],
  "properties": {
    "campaignId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^c[0-9a-f]{24}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "simulationTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stateHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
