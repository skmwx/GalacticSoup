{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/system.capabilities.data.schema.json",
  "title": "CapabilitiesData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "engineVersion",
    "requestTypes"
  ],
  "properties": {
    "protocolVersion": {
      "const": 8
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "requestTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
