{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/content.summary.data.schema.json",
  "title": "ContentSummaryData",
  "description": "Identity of the content the engine loaded (Technical Specification 6.3). The version and hash are the values a campaign snapshot records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentVersion", "contentHash", "defaultLocale", "locales", "definitionCounts"],
  "properties": {
    "contentVersion": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "defaultLocale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
    },
    "definitionCounts": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
