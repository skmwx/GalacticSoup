{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/content.messages.data.schema.json",
  "title": "ContentMessagesData",
  "description": "The authored message catalogue of one locale (Technical Specification 6.1, 12.5). Projections carry message keys; the interface resolves them against this catalogue instead of reading the content bundle itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "resolvedLocale", "contentVersion", "messages"],
  "properties": {
    "locale": { "type": "string", "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{2,8})*$" },
    "resolvedLocale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 160 },
      "additionalProperties": { "type": "string" }
    }
  }
}
