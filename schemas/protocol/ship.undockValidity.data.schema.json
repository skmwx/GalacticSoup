{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/ship.undockValidity.data.schema.json",
  "title": "UndockValidityData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "shipId",
    "undockable",
    "violations",
    "unavailableReason"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "shipId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
    },
    "undockable": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "https://galacticsoup.invalid/schemas/protocol/fitting.common.schema.json#/$defs/issue"
      }
    },
    "unavailableReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
