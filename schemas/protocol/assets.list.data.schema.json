{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/assets.list.data.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "credits",
    "location",
    "activeShipId",
    "ships",
    "inventories"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "credits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "location": {
      "$ref": "https://galacticsoup.invalid/schemas/protocol/assets.common.schema.json#/$defs/shipLocation"
    },
    "activeShipId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
    },
    "ships": {
      "type": "array",
      "items": {
        "$ref": "https://galacticsoup.invalid/schemas/protocol/assets.common.schema.json#/$defs/ship"
      }
    },
    "inventories": {
      "type": "array",
      "items": {
        "$ref": "https://galacticsoup.invalid/schemas/protocol/assets.common.schema.json#/$defs/inventory"
      }
    }
  }
}
