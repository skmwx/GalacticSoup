{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/assets.list.data.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "credits",
    "location",
    "activeShipId",
    "lastDockedStationId",
    "ships",
    "inventories"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "credits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "location": {
      "$ref": "https://galacticsoup.invalid/schemas/protocol/assets.common.schema.json#/$defs/shipLocation"
    },
    "activeShipId": {
      "description": "Null while the pilot owns no ship at the station they are docked at (Functional Specification 9.12).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
        }
      ]
    },
    "lastDockedStationId": {
      "description": "Where a destroyed pilot is recovered and where a retreat heads.",
      "type": "string",
      "pattern": "^station(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 96
    },
    "ships": {
      "type": "array",
      "items": {
        "$ref": "https://galacticsoup.invalid/schemas/protocol/assets.common.schema.json#/$defs/ship"
      }
    },
    "inventories": {
      "type": "array",
      "items": {
        "$ref": "https://galacticsoup.invalid/schemas/protocol/assets.common.schema.json#/$defs/inventory"
      }
    }
  }
}
