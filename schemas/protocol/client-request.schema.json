        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/confirmPreviewPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "targeting.lock",
              "targeting.unlock"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/targetPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "weapon.deactivate",
              "weapon.reload"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/weaponSlotPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "weapon.activate"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/activateWeaponPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "weapon.changeAmmunition"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/changeAmmunitionPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "entityId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
      "maxLength": 128
    },
    "stationId": {
      "type": "string",
      "pattern": "^station(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 96
    },
    "siteId": {
      "type": "string",
      "pattern": "^site(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 96
    },
    "encounterId": {
      "type": "string",
      "pattern": "^encounter(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 96
    },
    "definitionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 96
    },
    "positiveQuantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "selectDestinationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encounterId"
      ],
      "properties": {
        "encounterId": {
          "$ref": "#/$defs/encounterId"
        }
      }
    },
    "targetRangePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "distanceKm"
      ],
      "properties": {
        "targetId": {
          "oneOf": [
            {
              "$ref": "#/$defs/entityId"
            },
            {
              "$ref": "#/$defs/stationId"
            }
          ]
        },
        "distanceKm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "moveToPointPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xKm",
        "yKm"
      ],
      "properties": {
        "xKm": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "yKm": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      }
    },
    "warpPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinationSiteId",
        "arrivalDistanceKm"
      ],
      "properties": {
        "destinationSiteId": {
          "$ref": "#/$defs/siteId"
        },
        "arrivalDistanceKm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "stationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stationId"
      ],
      "properties": {
        "stationId": {
          "$ref": "#/$defs/stationId"
        }
      }
    },
    "shipEconomicPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shipId"
      ],
      "properties": {
        "shipId": {
          "$ref": "#/$defs/entityId"
        }
      }
    },
    "marketBuyPreviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stationId",
        "itemId",
        "quantity"
      ],
      "properties": {
        "stationId": {
          "$ref": "#/$defs/stationId"
        },
        "itemId": {
          "$ref": "#/$defs/definitionId"
        },
        "quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "destinationInventoryId": {
          "$ref": "#/$defs/entityId"
        }
      }
    },
    "marketSellPreviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stationId",
        "stackId",
        "quantity"
      ],
      "properties": {
        "stationId": {
          "$ref": "#/$defs/stationId"
        },
        "stackId": {
          "$ref": "#/$defs/entityId"
        },
        "quantity": {
          "$ref": "#/$defs/positiveQuantity"
        }
      }
    },
    "confirmPreviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "canonicalParameters",
            "campaignRevision",
            "relevantVersions",
            "valuesHash"
          ],
          "properties": {
            "action": {
              "enum": [
                "market.buy",
                "market.sell",
                "repair",
                "resupply",
                "insurance.enhance"
              ]
            },
            "canonicalParameters": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "campaignRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "relevantVersions": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 128,
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "valuesHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "createCampaignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAtRealMs",
        "displayName",
        "seed"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "createdAtRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "setTimePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paused",
        "rate"
      ],
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "advanceTimePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsedRealMs"
      ],
      "properties": {
        "elapsedRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "saveCampaignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "savedAtRealMs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "savedAtRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "closeCampaignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "savedAtRealMs"
      ],
      "properties": {
        "savedAtRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "contentMessagesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{2,8})*$",
          "maxLength": 35
        }
      }
    },
    "siteObjectId": {
      "oneOf": [
        {
          "$ref": "#/$defs/entityId"
        },
        {
          "$ref": "#/$defs/stationId"
        }
      ]
    },
    "ammunitionId": {
      "type": "string",
      "pattern": "^ammo(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 96
    },
    "targetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/siteObjectId"
        }
      }
    },
    "weaponSlotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotKind",
        "slotIndex"
      ],
      "properties": {
        "slotKind": {
          "const": "weapon"
        },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "moduleSlotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotKind",
        "slotIndex"
      ],
      "properties": {
        "slotKind": {
          "const": "system"
        },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "activateWeaponPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotKind",
        "slotIndex",
        "targetId"
      ],
      "properties": {
        "slotKind": {
          "const": "weapon"
        },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "targetId": {
          "$ref": "#/$defs/siteObjectId"
        }
      }
    },
    "changeAmmunitionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotKind",
        "slotIndex",
        "ammunitionId"
      ],
      "properties": {
        "slotKind": {
          "const": "weapon"
        },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "ammunitionId": {
          "$ref": "#/$defs/ammunitionId"
        }
      }
    }
  }
}
