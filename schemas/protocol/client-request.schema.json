{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/client-request.schema.json",
  "title": "ClientRequest",
  "description": "Protocol version 2 request envelope and payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "type",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "enum": [
        "assets.list",
        "campaign.close",
        "campaign.create",
        "campaign.frame",
        "campaign.reset",
        "campaign.resume",
        "campaign.save",
        "campaign.saves",
        "campaign.session",
        "content.summary",
        "diagnostics.stateHash",
        "inventory.cargo",
        "inventory.hangar",
        "inventory.maximum",
        "inventory.merge",
        "inventory.split",
        "inventory.transfer",
        "item.inspect",
        "system.capabilities",
        "system.health",
        "time.advance",
        "time.set",
        "wallet.get"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.frame"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.reset"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.resume"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.saves"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.session"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "content.summary"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "diagnostics.stateHash"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "system.capabilities"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "system.health"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.create"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/createCampaignPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "time.set"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/setTimePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "time.advance"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/advanceTimePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.save"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/saveCampaignPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "campaign.close"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/closeCampaignPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assets.list"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "wallet.get"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inventory.hangar"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stationId"
            ],
            "properties": {
              "stationId": {
                "type": "string",
                "pattern": "^station(?:\\.[a-z0-9][a-z0-9-]*)+$",
                "maxLength": 96
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inventory.cargo"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shipId"
            ],
            "properties": {
              "shipId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "item.inspect"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stackId"
            ],
            "properties": {
              "stackId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inventory.maximum"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stackId",
              "destinationInventoryId"
            ],
            "properties": {
              "stackId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              },
              "destinationInventoryId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inventory.transfer"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stackId",
              "destinationInventoryId",
              "quantity"
            ],
            "properties": {
              "stackId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              },
              "destinationInventoryId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inventory.split"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stackId",
              "quantity"
            ],
            "properties": {
              "stackId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "inventory.merge"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceStackId",
              "targetStackId"
            ],
            "properties": {
              "sourceStackId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              },
              "targetStackId": {
                "type": "string",
                "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$",
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "createCampaignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAtRealMs",
        "displayName",
        "seed"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "createdAtRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "setTimePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paused",
        "rate"
      ],
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "advanceTimePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsedRealMs"
      ],
      "properties": {
        "elapsedRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "saveCampaignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "savedAtRealMs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "savedAtRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "closeCampaignPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "savedAtRealMs"
      ],
      "properties": {
        "savedAtRealMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
