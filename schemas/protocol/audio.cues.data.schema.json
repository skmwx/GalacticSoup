{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/audio.cues.data.schema.json",
  "title": "AudioCuesData",
  "description": "The authored audible cues, as short tone sequences the interface synthesises (Technical Specification 12.3-12.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cues"
  ],
  "properties": {
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    }
  },
  "$defs": {
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "waveform",
        "defaultFor",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "alert",
            "interface",
            "effects"
          ]
        },
        "waveform": {
          "enum": [
            "sine",
            "square",
            "triangle",
            "sawtooth"
          ]
        },
        "defaultFor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "informational",
                "opportunity",
                "warning",
                "danger"
              ]
            }
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frequencyHz",
              "durationMs",
              "gain"
            ],
            "properties": {
              "frequencyHz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "durationMs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "gain": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
