{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/station.services.data.schema.json",
  "title": "StationServicesData",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "stationId", "nameKey", "docked", "serviceModifier", "services"],
  "properties": {
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "stationId": { "type": "string", "pattern": "^station\\." },
    "nameKey": { "type": "string", "minLength": 1 },
    "docked": { "type": "boolean" },
    "serviceModifier": { "type": "number", "exclusiveMinimum": 0 },
    "services": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "available", "unavailableReason"],
        "properties": {
          "service": { "enum": ["market", "fitting", "repair", "resupply", "insurance"] },
          "available": { "type": "boolean" },
          "unavailableReason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
