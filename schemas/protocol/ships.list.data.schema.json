{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/ships.list.data.schema.json",
  "title": "ShipsListData",
  "description": "The player's ships with their readiness and comparison figures (Functional Specification 6.3, 19.6; FeatureSpec02 4.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "activeShipId",
    "stationId",
    "draftShipId",
    "ships"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activeShipId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "stationId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "draftShipId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "ships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownedShip"
      }
    }
  },
  "$defs": {
    "location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stationId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "station"
            },
            "stationId": {
              "type": "string",
              "minLength": 1
            },
            "systemId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "siteId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "site"
            },
            "siteId": {
              "type": "string",
              "minLength": 1
            },
            "systemId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fromSiteId",
            "toSiteId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "warp"
            },
            "fromSiteId": {
              "type": "string",
              "minLength": 1
            },
            "toSiteId": {
              "type": "string",
              "minLength": 1
            },
            "systemId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "labelKey",
        "value",
        "better"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "better": {
          "enum": [
            "higher",
            "lower"
          ]
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "hitPoints",
        "maximumHitPoints"
      ],
      "properties": {
        "layer": {
          "enum": [
            "shield",
            "armor",
            "hull"
          ]
        },
        "hitPoints": {
          "type": "number",
          "minimum": 0
        },
        "maximumHitPoints": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ownedShip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hullId",
        "nameKey",
        "descriptionKey",
        "hullClass",
        "moduleSizes",
        "traitKeys",
        "active",
        "local",
        "location",
        "cargoInventoryId",
        "cargoUsedCubicDecimetres",
        "cargoCapacityCubicDecimetres",
        "fittedModules",
        "undockable",
        "layers",
        "capacitorCharge",
        "insuranceCoverage",
        "recoveryGrant",
        "referenceValueCredits",
        "figures",
        "activation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hullId": {
          "type": "string",
          "minLength": 1
        },
        "nameKey": {
          "type": "string",
          "minLength": 1
        },
        "descriptionKey": {
          "type": "string",
          "minLength": 1
        },
        "hullClass": {
          "enum": [
            "frigate",
            "destroyer",
            "cruiser"
          ]
        },
        "moduleSizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "small",
              "medium"
            ]
          }
        },
        "traitKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active": {
          "type": "boolean"
        },
        "local": {
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "cargoInventoryId": {
          "type": "string",
          "minLength": 1
        },
        "cargoUsedCubicDecimetres": {
          "type": "integer",
          "minimum": 0
        },
        "cargoCapacityCubicDecimetres": {
          "type": "integer",
          "minimum": 0
        },
        "fittedModules": {
          "type": "integer",
          "minimum": 0
        },
        "undockable": {
          "type": "boolean"
        },
        "layers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "capacitorCharge": {
          "type": "number",
          "minimum": 0
        },
        "insuranceCoverage": {
          "enum": [
            "basic",
            "enhanced"
          ]
        },
        "recoveryGrant": {
          "type": "boolean"
        },
        "referenceValueCredits": {
          "type": "integer",
          "minimum": 0
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "unavailableReason"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "unavailableReason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
