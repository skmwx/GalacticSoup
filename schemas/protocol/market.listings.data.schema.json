{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/market.listings.data.schema.json",
  "title": "MarketListingsData",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "stationId", "simulationHour", "listings", "unavailableReason"],
  "properties": {
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "stationId": { "type": "string", "pattern": "^station\\." },
    "simulationHour": { "type": "integer", "minimum": 0 },
    "unavailableReason": { "type": ["string", "null"] },
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "supply", "stock", "stationSellPriceCredits", "stationBuyPriceCredits", "stationSellTrace", "stationBuyTrace", "available", "unavailableReason"],
        "properties": {
          "item": { "$ref": "https://galacticsoup.invalid/schemas/protocol/economy.common.schema.json#/$defs/marketItem" },
          "supply": { "enum": ["dynamic", "fixed"] },
          "stock": { "type": ["integer", "null"], "minimum": 0 },
          "stationSellPriceCredits": { "type": "integer", "minimum": 1 },
          "stationBuyPriceCredits": { "type": "integer", "minimum": 1 },
          "stationSellTrace": { "$ref": "https://galacticsoup.invalid/schemas/protocol/economy.common.schema.json#/$defs/formulaTrace" },
          "stationBuyTrace": { "$ref": "https://galacticsoup.invalid/schemas/protocol/economy.common.schema.json#/$defs/formulaTrace" },
          "available": { "type": "boolean" },
          "unavailableReason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
