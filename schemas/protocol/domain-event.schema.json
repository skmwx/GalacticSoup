{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/domain-event.schema.json",
  "title": "DomainEventData",
  "description": "One event published by a committed transaction (Technical Specification 7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ordinal",
    "kind",
    "simulationTimeMs"
  ],
  "properties": {
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "simulationTimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    }
  }
}
