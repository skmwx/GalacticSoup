{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/navigation.destinations.data.schema.json",
  "title": "DestinationsData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "selectedEncounterId",
    "selectedBookmarkId",
    "destinations",
    "bookmarks"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selectedEncounterId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^encounter(?:\\.[a-z0-9][a-z0-9-]*)+$",
          "maxLength": 96
        }
      ]
    },
    "selectedBookmarkId": {
      "description": "The bookmark chosen at the station instead of an encounter; at most one of the two is set.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/entityId"
        }
      ]
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "encounterId",
          "siteId",
          "nameKey",
          "descriptionKey",
          "rewardSummaryKey",
          "tier",
          "selected",
          "current",
          "known",
          "spawns",
          "totalBountyCredits",
          "possibleLootItemIds",
          "possibleLoot",
          "completionCount",
          "commands"
        ],
        "properties": {
          "encounterId": {
            "type": "string",
            "pattern": "^encounter(?:\\.[a-z0-9][a-z0-9-]*)+$",
            "maxLength": 96
          },
          "siteId": {
            "type": "string",
            "pattern": "^site(?:\\.[a-z0-9][a-z0-9-]*)+$",
            "maxLength": 96
          },
          "nameKey": {
            "type": "string"
          },
          "descriptionKey": {
            "type": "string"
          },
          "rewardSummaryKey": {
            "type": "string"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "selected": {
            "type": "boolean"
          },
          "current": {
            "type": "boolean"
          },
          "known": {
            "type": "boolean"
          },
          "spawns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "npcProfileId",
                "nameKey",
                "role",
                "count",
                "bountyCredits"
              ],
              "properties": {
                "npcProfileId": {
                  "type": "string",
                  "pattern": "^npc(?:\\.[a-z0-9][a-z0-9-]*)+$",
                  "maxLength": 96
                },
                "nameKey": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "brawler",
                    "skirmisher",
                    "sniper"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "bountyCredits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "totalBountyCredits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "possibleLootItemIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(item|module|ammo)(?:\\.[a-z0-9][a-z0-9-]*)+$",
              "maxLength": 96
            }
          },
          "possibleLoot": {
            "description": "The disclosed loot with the names it is shown by (MVP Scope 4.2).",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId", "nameKey"],
              "properties": {
                "itemId": {
                  "type": "string",
                  "pattern": "^(item|module|ammo)(?:\\.[a-z0-9][a-z0-9-]*)+$",
                  "maxLength": 96
                },
                "nameKey": { "type": "string", "minLength": 1 }
              }
            }
          },
          "completionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "commands": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/commandAvailability"
            }
          }
        }
      }
    },
    "bookmarks": {
      "description": "The player's own wrecks in the current system, oldest first (Functional Specification 5.4, 7.3, 9.12).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/bookmarkDestination"
      }
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^c[0-9a-f]{24}-e[1-9][0-9]*$"
    },
    "bookmarkDestination": {
      "description": "A bookmark offered as a destination: in the MVP, the automatic one on the player's own wreck, chosen at the station and warped to without a system map.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookmarkId",
        "kind",
        "siteId",
        "siteNameKey",
        "hullNameKey",
        "encounterId",
        "encounterNameKey",
        "tier",
        "createdAtMs",
        "expiresAtMs",
        "remainingSeconds",
        "itemCount",
        "selected",
        "current",
        "commands"
      ],
      "properties": {
        "bookmarkId": {
          "$ref": "#/$defs/entityId"
        },
        "kind": {
          "const": "playerWreck"
        },
        "siteId": {
          "type": "string",
          "pattern": "^site(?:\\.[a-z0-9][a-z0-9-]*)+$",
          "maxLength": 96
        },
        "siteNameKey": {
          "type": "string"
        },
        "hullNameKey": {
          "type": "string"
        },
        "encounterId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^encounter(?:\\.[a-z0-9][a-z0-9-]*)+$",
              "maxLength": 96
            }
          ]
        },
        "encounterNameKey": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "tier": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          ]
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remainingSeconds": {
          "type": "number",
          "minimum": 0
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selected": {
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandAvailability"
          }
        }
      }
    },
    "commandAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "available",
        "unavailableReason"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "unavailableReason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    }
  }
}
