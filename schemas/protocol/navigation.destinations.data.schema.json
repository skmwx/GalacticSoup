{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticsoup.invalid/schemas/protocol/navigation.destinations.data.schema.json",
  "title": "DestinationsData",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "selectedEncounterId", "destinations"],
  "properties": {
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "selectedEncounterId": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^encounter(?:\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 96 }
      ]
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["encounterId", "siteId", "nameKey", "descriptionKey", "rewardSummaryKey", "tier", "selected", "current", "known", "available", "unavailableReason"],
        "properties": {
          "encounterId": { "type": "string", "pattern": "^encounter(?:\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 96 },
          "siteId": { "type": "string", "pattern": "^site(?:\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 96 },
          "nameKey": { "type": "string" },
          "descriptionKey": { "type": "string" },
          "rewardSummaryKey": { "type": "string" },
          "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
          "selected": { "type": "boolean" },
          "current": { "type": "boolean" },
          "known": { "type": "boolean" },
          "available": { "type": "boolean" },
          "unavailableReason": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
        }
      }
    }
  }
}
